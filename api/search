"56":1,"57":1,"58":1,"59":1,"60":1,"61":1,"62":1,"63":1,"64":1,"65":1,"66":1,"67":1,"68":1,"69":1,"70":1,"71":1,"72":1,"73":1,"74":1,"75":1,"76":1,"77":1,"78":1,"79":1,"80":1,"81":1,"82":1,"83":1,"84":1,"85":2,"86":2,"87":2,"88":2,"89":2,"90":2,"91":2,"92":2,"93":2,"94":2,"95":2,"96":2,"97":2,"98":1,"99":1,"100":1,"101":1,"102":1,"103":1,"104":1,"105":1,"106":1,"107":1,"108":1,"109":1,"110":1,"111":1,"112":1,"113":1,"114":1,"115":1,"116":1,"117":1,"118":1,"119":1,"120":1,"121":1,"122":1,"123":1,"124":1,"125":1,"126":1}}},"docs":{"docs":{"1":{"id":"/assumptions","page_id":"/assumptions","type":"page","content":"Open assumptions","breadcrumbs":["Rock Your Baby, Team 34"],"tags":[],"url":"/assumptions"},"2":{"id":"/assumptions-0","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"The open points in the design, and when we close each one"},"3":{"id":"/assumptions-1","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"Question"},"4":{"id":"/assumptions-2","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"What we're assuming now"},"5":{"id":"/assumptions-3","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"When we close it"},"6":{"id":"/assumptions-4","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"Are crying and heart rate linked?"},"7":{"id":"/assumptions-5","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"We treat them as two separate signs of the same stress, not as one causing the other. So S3 does not expect one to directly change the other."},"8":{"id":"/assumptions-6","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"At Demo 1, on the digital twin: we look at both signals together and check whether they move together more than the model says. If they do, S3 will weigh them accordingly."},"9":{"id":"/assumptions-7","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"How do we drive the motors?"},"10":{"id":"/assumptions-8","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"S4 sends the two 1 kHz PWM signals (rocking speed and rocking strength) on the motor connections of the board. The cradle setup gives the motors their power."},"11":{"id":"/assumptions-9","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"First cradle time slot, before Demo 1: we measure the load (must stay above 0.8 A) and the duty (must stay under 90%)."},"12":{"id":"/assumptions-10","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"Can the timers keep up?"},"13":{"id":"/assumptions-11","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"We build on the fixed PYNQ Z2 board: its UART and I2C for the communication, its general-purpose timers for the 1 kHz PWM signals. We assume the timers can keep both PWM signals at exactly 1 kHz with stable duty, even while the communication code runs."},"14":{"id":"/assumptions-12","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"First bring-up: we check both signals on the oscilloscope, before Demo 1."},"15":{"id":"/assumptions-13","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"Do the two measurements arrive at the same time?"},"16":{"id":"/assumptions-14","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"Each sensor board cleans up its own signal first: S1 sends a ready BPM value (with trend) at 2 Hz, S2 sends the filtered cry level at 10 Hz. So S3 combines two finished values, not raw waves. The open point: the two values must arrive close enough together for S3 to combine them at 1 decision per second."},"17":{"id":"/assumptions-15","page_id":"/assumptions","tags":[],"type":"text","url":"/assumptions","content":"COMM-2 test (Section 2.4): we measure how long each signal takes to arrive. S3 writes a timestamp on both values, so if one is late, it shows up on the LCD."},"18":{"id":"/communication","page_id":"/communication","type":"page","content":"Communication","tags":[],"url":"/communication"},"19":{"id":"/communication-0","page_id":"/communication","tags":[],"type":"text","url":"/communication","content":"How the four boards talk to each other"},"20":{"id":"/communication-1","page_id":"/communication","type":"heading","tags":[],"url":"/communication#full-system","content":"Full system"},"21":{"id":"/communication-2","page_id":"/communication","type":"heading","tags":[],"url":"/communication#option-1-shared-uart-line","content":"Option 1: shared UART line"},"22":{"id":"/communication-3","page_id":"/communication","type":"heading","tags":[],"url":"/communication#option-2-i2c-link","content":"Option 2: I2C link"},"23":{"id":"/communication-4","page_id":"/communication","tags":[],"type":"text","url":"/communication","content":"The four PYNQ boards sit in the cradle backbone and exchange heartbeat, crying, decision, and command signals. Two topologies are under evaluation."},"24":{"id":"/communication-5","page_id":"/communication","tags":[],"type":"text","url":"/communication#full-system","content":"The cradle sensors (photo detector, mic) feed S1 and S2; S1 and S2 send SIG_HR and SIG_CR to S3; S3 sends SIG_CMD to S4; S4 drives the cradle motors with two 1 kHz PWM signals."},"25":{"id":"/communication-6","page_id":"/communication","tags":[],"type":"text","url":"/communication#option-1-shared-uart-line","content":"Every board has its own TX and RX on the backbone, plus a common ground. UART is point-to-point, so addressing and turn-taking are built on top of it: each board gets a 4-bit address and every frame carries a destination."},"26":{"id":"/communication-7","page_id":"/communication","tags":[],"type":"text","url":"/communication#option-2-i2c-link","content":"One shared data wire (SDA) and one clock wire (SCL) with a common ground. S3 acts as the master, S1, S2 and S4 as slaves. Addressing is built into the protocol, so no frame header is needed."},"27":{"id":"/document","page_id":"/document","type":"page","content":"Design document","breadcrumbs":["Rock Your Baby, Team 34"],"tags":[],"url":"/document"},"28":{"id":"/document-0","page_id":"/document","tags":[],"type":"text","url":"/document","content":"The latest version of our design document"},"29":{"id":"/document-1","page_id":"/document","type":"heading","tags":[],"url":"/document#versions","content":"Versions"},"30":{"id":"/document-2","page_id":"/document","tags":[],"type":"text","url":"/document","content":"Section 2 not final"},"31":{"id":"/document-3","page_id":"/document","tags":[],"type":"text","url":"/document","content":"**RYB_Team34_DesignDocument.pdf**, 17 pages"},"32":{"id":"/document-4","page_id":"/document","tags":[],"type":"text","url":"/document","content":"Download the PDF"},"33":{"id":"/document-5","page_id":"/document","tags":[],"type":"text","url":"/document#versions","content":"Version"},"34":{"id":"/document-6","page_id":"/document","tags":[],"type":"text","url":"/document#versions","content":"Status"},"35":{"id":"/document-7","page_id":"/document","tags":[],"type":"text","url":"/document#versions","content":"v1.4"},"36":{"id":"/document-8","page_id":"/document","tags":[],"type":"text","url":"/document#versions","content":"Sections 1 and 2"},"37":{"id":"/","page_id":"/","type":"page","content":"Overview","breadcrumbs":["Rock Your Baby, Team 34"],"tags":[],"url":"/"},"38":{"id":"/-0","page_id":"/","tags":[],"type":"text","url":"/","content":"Where we are with the design document"},"39":{"id":"/-1","page_id":"/","type":"heading","tags":[],"url":"/#status","content":"Status"},"40":{"id":"/-2","page_id":"/","type":"heading","tags":[],"url":"/#the-team","content":"The team"},"41":{"id":"/-3","page_id":"/","type":"heading","tags":[],"url":"/#the-system","content":"The system"},"42":{"id":"/-4","page_id":"/","type":